<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_approval_flow_approver" model="res.groups">
        <field name="name">Approval Flow Approver</field>
        <field name="privilege_id" ref="approval_flow_builder.res_groups_privilege_approval_flow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_flow_administrator" model="res.groups">
        <field name="name">Approval Flow Administrator</field>
        <field name="privilege_id" ref="approval_flow_builder.res_groups_privilege_approval_flow"/>
        <field name="implied_ids" eval="[(4, ref('approval_flow_builder.group_approval_flow_approver'))]"/>
    </record>

    <record id="rule_approval_flow_request_approver_read" model="ir.rule">
        <field name="name">Approval requests visible to requester or current approver</field>
        <field name="model_id" ref="model_approval_flow_request"/>
        <field name="groups" eval="[(4, ref('approval_flow_builder.group_approval_flow_approver')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">['|', '|', '|', ('create_uid', '=', user.id), ('log_ids.user_id', '=', user.id), ('current_step_id.employee_id.user_id', '=', user.id), ('current_step_id.group_id.all_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_approval_flow_request_administrator_read" model="ir.rule">
        <field name="name">Approval administrators can read all requests</field>
        <field name="model_id" ref="model_approval_flow_request"/>
        <field name="groups" eval="[(4, ref('approval_flow_builder.group_approval_flow_administrator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_approval_flow_log_approver_read" model="ir.rule">
        <field name="name">Approval logs visible to involved users</field>
        <field name="model_id" ref="model_approval_flow_log"/>
        <field name="groups" eval="[(4, ref('approval_flow_builder.group_approval_flow_approver')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">['|', '|', '|', '|', ('request_id.create_uid', '=', user.id), ('user_id', '=', user.id), ('request_id.log_ids.user_id', '=', user.id), ('request_id.current_step_id.employee_id.user_id', '=', user.id), ('request_id.current_step_id.group_id.all_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_approval_flow_log_administrator_read" model="ir.rule">
        <field name="name">Approval administrators can read all logs</field>
        <field name="model_id" ref="model_approval_flow_log"/>
        <field name="groups" eval="[(4, ref('approval_flow_builder.group_approval_flow_administrator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
